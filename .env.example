MISTRAL_API_KEY=sk-replace-me
# The quality CLI's second cloud subject (gemini-3.5-flash-lite). Free tier
# caps at 15 requests/minute; quality_cli paces its own calls to stay under it.
GOOGLE_API_KEY=AIza-replace-me
# Which quality-CLI providers to attempt. A provider left out here, missing
# its key, or failing its own pre-flight is skipped (one stderr line, zero
# rows), never aborts the run.
# QUALITY_PROVIDERS=local,mistral,google
SLM_MODELS_DIR=D:\ia\models
LLAMA_SERVER_PATH=C:\path\to\llama-server.exe
RUNTIME_RESULTS_PATH=aidd_docs/results/runtime.jsonl
QUALITY_RESULTS_PATH=aidd_docs/results/quality.jsonl
# RUNTIME_REPETITIONS=5
# RUNTIME_COOLDOWN_S=10.0
# RUNTIME_WARMUP_COUNT=1
# RUNTIME_SPREAD_THRESHOLD=0.10
# Host-fitted launch flags (--n-cpu-moe, -t). Defaults reproduce the validated
# baseline command on this project's own laptop fiche; override on other hardware.
# SERVER_N_CPU_MOE=37
# SERVER_THREADS=8
# The model roster and which of its entries a run launches. The tracked roster
# ships with one entry, so neither is expected to be overridden today.
# ROSTER_PATH=aidd_docs/roster/models.json
# ROSTER_ENTRY_ID=qwen3.6-35b-a3b-ud-iq4xs
# Where the write-once hardware fiches every row cites by hash are stored.
# Tracked in git; `wave-local-ai-v2-validate` reads the same directory.
# FICHE_REGISTRY_DIR=aidd_docs/results/fiches
# The reference files each run's reproduction verdict is computed against, and
# the relative gen_tok_per_s gap a runtime re-run may show and still count as
# reproduced. Distinct from RUNTIME_SPREAD_THRESHOLD: that one gates whether
# one run's own repetitions agree, this one whether two separate runs do.
# RUNTIME_REFERENCE_PATH=aidd_docs/results/runtime-reference.jsonl
# QUALITY_REFERENCE_PATH=aidd_docs/results/quality-reference.jsonl
# RUNTIME_REPRODUCTION_TOLERANCE=0.10
