MISTRAL_API_KEY=sk-replace-me
# The quality CLI's second cloud subject (gemini-3.5-flash-lite). Free tier
# caps at 15 requests/minute; quality_cli paces its own calls to stay under it.
GOOGLE_API_KEY=AIza-replace-me
# Which quality-CLI providers to attempt. A provider left out here, missing
# its key, or failing its own pre-flight is skipped (one stderr line, zero
# rows), never aborts the run.
# QUALITY_PROVIDERS=local,mistral,google
SLM_MODELS_DIR=D:\ia\models
LLAMA_SERVER_PATH=C:\path\to\llama-server.exe
RUNTIME_RESULTS_PATH=aidd_docs/results/runtime.jsonl
QUALITY_RESULTS_PATH=aidd_docs/results/quality.jsonl
# RUNTIME_REPETITIONS=5
# RUNTIME_COOLDOWN_S=10.0
# RUNTIME_WARMUP_COUNT=1
# RUNTIME_SPREAD_THRESHOLD=0.10
# Host-fitted launch flags (--n-cpu-moe, -t). Leave both unset to reproduce the
# validated baseline command on this project's own laptop fiche; override on
# other hardware. Unset, SERVER_N_CPU_MOE means "the selected entry decides":
# 37 for the MoE flagship, no --n-cpu-moe at all for a dense entry. Set, it
# overrides the entry -- and any value, 0 included, makes a dense entry refuse.
# SERVER_N_CPU_MOE=37
# SERVER_THREADS=8
# The model roster and which of its four entries a run launches: the MoE
# flagship below, or one of qwen3-0.6b-q8 / qwen3-1.7b-q8 / qwen3-4b-q4km.
# ROSTER_PATH=aidd_docs/roster/models.json
# ROSTER_ENTRY_ID=qwen3.6-35b-a3b-ud-iq4xs
# Where the write-once hardware fiches every row cites by hash are stored.
# Tracked in git; `wave-local-ai-v2-validate` reads the same directory.
# FICHE_REGISTRY_DIR=aidd_docs/results/fiches
# The reference files each run's reproduction verdict is computed against, and
# the relative gen_tok_per_s gap a runtime re-run may show and still count as
# reproduced. Distinct from RUNTIME_SPREAD_THRESHOLD: that one gates whether
# one run's own repetitions agree, this one whether two separate runs do.
# RUNTIME_REFERENCE_PATH=aidd_docs/results/runtime-reference.jsonl
# QUALITY_REFERENCE_PATH=aidd_docs/results/quality-reference.jsonl
# RUNTIME_REPRODUCTION_TOLERANCE=0.10
# Where wave-local-ai-v2-judge-probe writes its eleven judged rows. The one
# reference-named file a CLI writes to: the probe is a one-off proof, not a
# per-machine benchmark, so a re-run appends rather than replaces.
# JUDGE_PROBE_REFERENCE_PATH=aidd_docs/results/judge-probe-reference.jsonl
# Two judges more than this many points apart on a 1-5 ordinal rubric (or any
# category mismatch on a categorical one) mark that item contested: it stays
# on the row and is excluded from the judged headline, which reports how many.
# CONTESTED_ORDINAL_MAX_DELTA=1
# The read-only results service (wave-local-ai-v2-serve). No key value ships
# in this repo: the placeholder below is a placeholder, and the service
# refuses to start without a real one -- on a loopback bind too. A loopback
# client is then answered without a header; every other client must send a
# matching X-API-Key.
SERVICE_API_KEY=service-key-replace-me
# SERVICE_HOST=127.0.0.1
# SERVICE_PORT=8000
# The schema version at or above which a stored row is rendered. A row below
# it is counted in the response's `unreadable` list naming its version, never
# dropped and never rendered half-populated. Leaving RUNTIME_RESULTS_PATH /
# QUALITY_RESULTS_PATH above pointed at aidd_docs/results/*-reference.jsonl
# serves the committed bundle (schema "7") from the same service with no code
# change.
# SERVICE_SCHEMA_FLOOR=7
