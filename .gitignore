# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Front end (frontend/dist is already covered by the dist/ rule above)
frontend/node_modules

# scripts/generate_dev_cert.py's default output: a self-signed cert/key pair,
# never committed.
dev-certs/

# --- Project ---
.env
.venv/
models/
*.gguf
*.safetensors
results/raw/
# The container path: compose mounts ${RESULTS_DIR:-./results} and writes the
# same live rows there that a bare-metal run writes under aidd_docs/results/.
results/*.jsonl
# Every live append target, whatever RESULTS_PATH points at, since both store
# paths are configurable. The *-reference.jsonl bundle files next to them are
# derived by wave-local-ai-v2-merge-bundle and committed, so they are
# re-included; the per-machine locations under machines/ are not matched.
aidd_docs/results/*.jsonl
!aidd_docs/results/*-reference.jsonl
!aidd_docs/results/*-reference.schema-*.jsonl
__pycache__/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
